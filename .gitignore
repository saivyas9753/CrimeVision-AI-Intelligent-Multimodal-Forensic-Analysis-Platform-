# Environment files (exclude all .env except example)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Python virtual environments & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
env/
ENV/
build/
*.egg-info/

# Node.js dependencies & builds
node_modules/
frontend/node_modules/
dist/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# User uploaded evidence & generated reports (protects user privacy)
backend/uploads/images/*
backend/uploads/audio/*
backend/uploads/video/*
backend/uploads/reports/*
!backend/uploads/images/.gitkeep
!backend/uploads/audio/.gitkeep
!backend/uploads/video/.gitkeep
!backend/uploads/reports/.gitkeep

# Any temporary uploaded test evidence in uploads root
backend/uploads/test_*
backend/uploads/*_*.*

# Temporary / Scratch Audit Files
backend/uploads/static/security_audit.html

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
